{"id":2303,"unit_id":23,"title":"Understand Everyday Rules","description":"Read and hear common rules, obligations and permissions.","lesson_type":"practice","order_in_unit":2,"duration_min":12,"is_review":false,"exercises":[{"id":23025,"lesson_id":2303,"type":"teaching","prompt":"Read the rule as a whole","data":{"type":"teaching","style":"list","heading":"Must, may, must not","body":"These three chunks change the meaning of a rule completely.","items":[{"cz":"Musíte mít jízdenku.","en":"You must have a ticket."},{"cz":"Můžete tady čekat.","en":"You may wait here."},{"cz":"Nesmíte kouřit.","en":"You must not smoke."},{"cz":"Nemusíte spěchat.","en":"You do not have to hurry."}]},"answer_key":"modal chunks","xp_reward":0},{"id":23026,"lesson_id":2303,"type":"listening_comprehension","prompt":"Listen to the office rule","data":{"type":"listening_comprehension","prompt_en":"What must visitors do?","transcript_cz":"Dobrý den. Musíte se zapsat na recepci. Můžete čekat tady, ale nesmíte používat výtah bez karty.","questions":[{"question_en":"What must visitors do?","options":["Register at reception","Use the lift","Go home"],"correct_index":0},{"question_en":"What is prohibited?","options":["Using the lift without a card","Waiting","Speaking"],"correct_index":0}]},"answer_key":"register; no lift","xp_reward":15},{"id":23027,"lesson_id":2303,"type":"reading_comprehension","prompt":"Read the building instructions","data":{"type":"reading_comprehension","prompt_en":"Find what is required, allowed and forbidden.","image":"assets/images/unit23/everyday_choices_v1.png","image_label":"Asking about everyday rules","text_cz":"V budově musíte mít návštěvnickou kartu. Můžete si dát kávu v kuchyni. Nesmíte parkovat před vchodem. Nemusíte přijít brzy, ale schůzka začíná v devět.","text_en":"In the building you must have a visitor card. You may have coffee in the kitchen. You must not park in front of the entrance. You do not have to arrive early, but the meeting starts at nine.","questions":[{"question_en":"Where may visitors have coffee?","options":["In the kitchen","At the entrance","In the lift"],"correct_index":0},{"question_en":"What is not allowed?","options":["Parking at the entrance","Having a card","Coming at nine"],"correct_index":0}]},"answer_key":"kitchen; parking","xp_reward":15},{"id":23028,"lesson_id":2303,"type":"matching","prompt":"Match each modal meaning","data":{"type":"matching","pairs":[{"left":"musíte","right":"you must"},{"left":"můžete","right":"you may/can"},{"left":"nesmíte","right":"you must not"},{"left":"nemusíte","right":"you do not have to"}]},"answer_key":"modal meanings","xp_reward":10},{"id":23029,"lesson_id":2303,"type":"fill_blank","prompt":"Choose the prohibition","data":{"type":"fill_blank","sentence":"Tady ___ kouřit.","blank_count":1,"blank_answers":[["nesmíte"]]},"answer_key":"nesmíte","xp_reward":10},{"id":23030,"lesson_id":2303,"type":"dialogue","prompt":"Ask for permission","data":{"type":"dialogue","scenario":"At reception","lines":[{"speaker":"you","text":"___ tady čekat?"},{"speaker":"receptionist","text":"Ano, můžete."}],"blank_answers":[["Můžu","Mohu"]]},"answer_key":"Můžu","xp_reward":15},{"id":23031,"lesson_id":2303,"type":"writing_task","prompt":"Write two clear rules","data":{"type":"writing_task","prompt_en":"Write one required action and one prohibited action for a place you know.","prompt_cz":"Napište dvě krátká pravidla.","min_words":8,"max_words":35,"key_vocab":["musíte","nesmíte","můžete"],"sample_answer":"V práci musíte mít kartu. Nesmíte kouřit."},"answer_key":"two rules","xp_reward":0},{"id":23032,"lesson_id":2303,"type":"speaking_task","prompt":"Explain a rule aloud","data":{"type":"speaking_task","prompt_en":"Record 15–25 seconds explaining one rule and asking one permission question.","prompt_cz":"Nahrajte krátké vysvětlení pravidel.","min_duration_seconds":15,"max_duration_seconds":30,"expected_phrases":["musíte","nesmíte","můžu"]},"answer_key":"rules spoken","xp_reward":20}]}
