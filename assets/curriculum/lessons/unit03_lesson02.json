      "prompt": "Build three retrieval shelves",
      "data": {
        "type": "teaching",
        "style": "list",
        "heading": "ten · ta · to",
        "body": "These are grammatical noun groups, not a statement about biology. Endings can help you guess, but they are not guarantees: dítě is neuter although it means a child, and židle is feminine although it does not end in -a. Store the whole chunk.",
        "play_all_label": "Hear the three shelves",
        "items": [
          {
            "cz": "ten muž · ten pes · ten dům · ten stůl",
            "say": "ten muž, ten pes, ten dům, ten stůl",
            "en": "MASCULINE — a consonant ending is a useful first cue"
          },
          {
            "cz": "ta žena · ta káva · ta kniha · ta židle",
            "say": "ta žena, ta káva, ta kniha, ta židle",
            "en": "FEMININE — -a is a common cue; židle must be learned"
          },
          {
            "cz": "to dítě · to auto · to okno · to město",
            "say": "to dítě, to auto, to okno, to město",
            "en": "NEUTER — -o is a common cue; dítě must be learned"
          }
        ]
      },
      "xp_reward": 0
