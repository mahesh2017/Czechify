{"id":2304,"unit_id":23,"title":"Ask, Explain and Follow Rules","description":"Complete a practical permission-and-rules mission.","lesson_type":"mission","order_in_unit":3,"duration_min":12,"is_review":true,"exercises":[{"id":23033,"lesson_id":2304,"type":"teaching","prompt":"Mission language","data":{"type":"teaching","style":"list","heading":"Ask, then act","body":"Ask permission politely and make the rule clear.","items":[{"cz":"Můžu tady…?","en":"May I… here?"},{"cz":"Musíte nejdřív…","en":"You must first…"},{"cz":"Tady se nesmí…","en":"Here one must not…"}]},"answer_key":"mission chunks","xp_reward":0},{"id":23034,"lesson_id":2304,"type":"listening_comprehension","prompt":"Listen to the station announcement","data":{"type":"listening_comprehension","prompt_en":"What must passengers do?","transcript_cz":"Cestující musí mít platnou jízdenku. Ve vlaku se nesmí kouřit. Můžete si koupit pití ve voze číslo tři.","questions":[{"question_en":"What must passengers have?","options":["A valid ticket","A car","A key"],"correct_index":0},{"question_en":"Where can they buy a drink?","options":["Car three","The platform","The office"],"correct_index":0}]},"answer_key":"ticket; car three","xp_reward":15},{"id":23035,"lesson_id":2304,"type":"reading_comprehension","prompt":"Read the visitor rules","data":{"type":"reading_comprehension","prompt_en":"Decide what you can and cannot do.","image":"assets/images/unit23/everyday_choices_v1.webp","image_label":"Clarifying everyday rules","text_cz":"Návštěvy mohou přijít od dvou do šesti. Musí zazvonit u vchodu. Nesmí nechat kolo v chodbě. Jestli potřebují pomoc, mohou zavolat správci.","text_en":"Visitors may come from two to six. They must ring at the entrance. They must not leave a bicycle in the corridor. If they need help, they can call the building manager.","questions":[{"question_en":"What must a visitor do?","options":["Ring at the entrance","Leave a bicycle","Arrive at midnight"],"correct_index":0},{"question_en":"Who can they call for help?","options":["The building manager","A doctor","A driver"],"correct_index":0}]},"answer_key":"ring; manager","xp_reward":15},{"id":23036,"lesson_id":2304,"type":"matching","prompt":"Match rule and place","data":{"type":"matching","pairs":[{"left":"platná jízdenka","right":"vlak"},{"left":"zvonit u vchodu","right":"budova"},{"left":"nekouřit","right":"veřejné místo"},{"left":"zavolat správci","right":"pomoc v domě"}]},"answer_key":"rules and places","xp_reward":10},{"id":23037,"lesson_id":2304,"type":"fill_blank","prompt":"Make the permission question","data":{"type":"fill_blank","sentence":"___ si tady sednout?","blank_count":1,"blank_answers":[["Můžu"]]},"answer_key":"Můžu","xp_reward":10},{"id":23038,"lesson_id":2304,"type":"dialogue","prompt":"Give a clear answer","data":{"type":"dialogue","scenario":"At a public office","lines":[{"speaker":"visitor","text":"Můžu tady fotografovat?"},{"speaker":"you","text":"___"}],"blank_answers":[["Ne, tady se nesmí fotografovat."]]},"answer_key":"Ne, tady se nesmí fotografovat.","xp_reward":15},{"id":23039,"lesson_id":2304,"type":"writing_task","prompt":"Complete the rules mission","data":{"type":"writing_task","prompt_en":"Write three short instructions for visitors: one must, one may, one must not.","prompt_cz":"Napište tři pravidla pro návštěvu.","min_words":12,"max_words":50,"key_vocab":["musíte","můžete","nesmíte"],"sample_answer":"Musíte zazvonit. Můžete čekat v hale. Nesmíte kouřit."},"answer_key":"rules mission","xp_reward":0},{"id":23040,"lesson_id":2304,"type":"speaking_task","prompt":"Complete the mission","data":{"type":"speaking_task","prompt_en":"Record a 20–30 second explanation of rules and one permission question.","prompt_cz":"Nahrajte pravidla a otázku.","min_duration_seconds":20,"max_duration_seconds":35,"expected_phrases":["musíte","můžete","nesmíte"]},"answer_key":"rules mission","xp_reward":20}]}
