      "type": "multiple_choice",
      "prompt": "What does the perfective present form 'napíšu' mean?",
      "data": {
        "type": "multiple_choice",
        "question_cz": "Co znamená 'napíšu'?",
        "question_en": "What does 'napíšu' mean?",
        "options": [
          "I am writing (now)",
          "I will write",
          "I wrote",
          "I was writing"
        ],
        "correct_index": 1,
        "explanation": "Perfective verbs like 'napíšu' have NO present meaning — their present-tense form expresses future: 'napíšu' = I will write. This is the core rule of Czech future: perfective present = future action. Compare: 'píšu' (imperfective) = I am writing now, 'napíšu' (perfective) = I will write."
      },
      "answer_key": "I will write",
      "grammar_rule_id": "GR-191",
      "xp_reward": 10
