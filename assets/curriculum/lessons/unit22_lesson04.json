{"id":2204,"unit_id":22,"title":"Solve a Plan Problem","description":"Complete a realistic reason-and-new-plan mission.","lesson_type":"mission","order_in_unit":3,"duration_min":12,"is_review":true,"exercises":[{"id":22033,"lesson_id":2204,"type":"teaching","prompt":"Mission language","data":{"type":"teaching","style":"list","heading":"A useful update","body":"State the problem, explain why, then offer the next step.","items":[{"cz":"Nemůžu přijít, protože…","en":"I cannot come because…"},{"cz":"Když budeš mít čas…","en":"When you have time…"},{"cz":"Až skončím, zavolám.","en":"When I finish, I will call."}]},"answer_key":"mission chunks","xp_reward":0},{"id":22034,"lesson_id":2204,"type":"listening_comprehension","prompt":"Listen for the solution","data":{"type":"listening_comprehension","prompt_en":"What is the solution?","transcript_cz":"Dnes se nemůžeme sejít, protože je Tomáš nemocný. Když mu bude lépe, půjdeme spolu na kávu. Zítra mu napíšu.","questions":[{"question_en":"Why can they not meet?","options":["Tomáš is ill","The train is late","It is cold"],"correct_index":0},{"question_en":"What will the speaker do tomorrow?","options":["Write to Tomáš","Go to work","Travel"],"correct_index":0}]},"answer_key":"ill; write","xp_reward":15},{"id":22035,"lesson_id":2204,"type":"reading_comprehension","prompt":"Read the final update","data":{"type":"reading_comprehension","prompt_en":"Identify the reason and alternative.","image":"assets/images/unit22/connected_ideas_v1.png","image_label":"Explaining a changed plan","text_cz":"Ahoj, nemám dnes auto, protože je v opravě. Jestli chceš, pojedeme tramvají. Když nebudeš mít čas, uvidíme se o víkendu.","text_en":"Hi, I do not have the car today because it is being repaired. If you want, we will go by tram. If you do not have time, we will see each other at the weekend.","questions":[{"question_en":"Why is there no car?","options":["It is being repaired","It is expensive","It is late"],"correct_index":0},{"question_en":"What is the alternative transport?","options":["Tram","Plane","Bicycle"],"correct_index":0}]},"answer_key":"repair; tram","xp_reward":15},{"id":22036,"lesson_id":2204,"type":"matching","prompt":"Match update parts","data":{"type":"matching","pairs":[{"left":"problém","right":"nemám auto"},{"left":"důvod","right":"je v opravě"},{"left":"alternativa","right":"pojedeme tramvají"},{"left":"nový čas","right":"o víkendu"}]},"answer_key":"update parts","xp_reward":10},{"id":22037,"lesson_id":2204,"type":"fill_blank","prompt":"Complete the future condition","data":{"type":"fill_blank","sentence":"___ budeš mít čas, uvidíme se o víkendu.","blank_count":1,"blank_answers":[["Když"]]},"answer_key":"Když","xp_reward":10},{"id":22038,"lesson_id":2204,"type":"dialogue","prompt":"Offer a solution","data":{"type":"dialogue","scenario":"A changed journey","lines":[{"speaker":"friend","text":"Auto nefunguje."},{"speaker":"you","text":"___"}],"blank_answers":[["Pojedeme tramvají, když chceš."]]},"answer_key":"Pojedeme tramvají, když chceš.","xp_reward":15},{"id":22039,"lesson_id":2204,"type":"writing_task","prompt":"Complete the mission","data":{"type":"writing_task","prompt_en":"Write a three-sentence message: problem, reason, and alternative plan.","prompt_cz":"Napište zprávu s řešením.","min_words":14,"max_words":55,"key_vocab":["protože","jestli/když","můžeme"],"sample_answer":"Dnes nemůžu přijít, protože pracuju. Jestli chceš, sejdeme se zítra v kavárně."},"answer_key":"plan solution","xp_reward":0},{"id":22040,"lesson_id":2204,"type":"speaking_task","prompt":"Complete the mission","data":{"type":"speaking_task","prompt_en":"Record a 20–30 second update with a reason and an alternative.","prompt_cz":"Nahrajte řešení změněného plánu.","min_duration_seconds":20,"max_duration_seconds":35,"expected_phrases":["protože","když/jestli","můžeme"]},"answer_key":"plan problem mission","xp_reward":20}]}
