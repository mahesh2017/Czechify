      "data": {
        "type": "translation",
        "direction": "cz_to_en",
        "source": "Odjíždíme zítra ráno.",
        "accepted_answers": [
          "We are leaving tomorrow morning.",
          "We depart tomorrow morning.",
          "We're leaving tomorrow morning."
        ],
        "grammar_note": "'Odjíždíme' = we are leaving (imperfective present of 'odjíždět' — departing by vehicle, 1st person plural). The prefix 'od-' = leaving/departing, and 'jezdit' → 'odjíždět' (by vehicle, habitual/process). 'Zítra ráno' = tomorrow morning. The imperfective 'odjíždět' here describes a planned future departure as a process. The perfective equivalent 'odjedeme' would emphasize completion."
      },
      "answer_key": "We are leaving tomorrow morning.",
      "grammar_rule_id": "GR-261",
