      "prompt": "Translate to Czech: 'He arrived home on foot at eight o'clock.'",
      "data": {
        "type": "translation",
        "direction": "en_to_cz",
        "source": "He arrived home on foot at eight o'clock.",
        "accepted_answers": [
          "Přišel domů v osm hodin.",
          "On přišel domů v osm hodin.",
          "Přišel domů v osm."
        ],
        "grammar_note": "'Přišel domů v osm hodin.' = He arrived home on foot at eight o'clock. 'Přišel' = he arrived (perfective past of 'přijít' — arrival on foot, masculine). 'Domů' = home (direction adverb). 'V osm hodin' = at eight o'clock. The prefix 'při-' signals arrival, and 'jít' (on foot) → past 'přišel'. The perfective is used because the arrival is completed."
      },
      "answer_key": "Přišel domů v osm hodin.",
