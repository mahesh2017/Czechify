# Copy to .env (gitignored) and fill in. Needed only by
# tool/upload_audio_pack.py, which writes to Supabase Storage.
#
# The app itself does NOT need this: it builds from env/prod.json, which
# carries only the publishable (anon) key. That key is safe to commit —
# row-level security is what protects the data, not its secrecy.
#
# This one is different. It bypasses RLS entirely, so treat it like a
# password: never paste it into a chat, an issue, or a commit.
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret key from Supabase dashboard>

# Azure Speech — needed by tool/generate_audio_pack.py (Czech) and
# tool/generate_intro_audio.py (English unit intros).
# The region is NOT a preference — it must match wherever your Speech
# resource was created, or requests return 401. It does not affect audio
# quality (the same neural voice is identical in every region); it only
# affects latency, data residency, and which newer voices are available.
AZURE_SPEECH_KEY=<key from the Azure Speech resource>
AZURE_SPEECH_REGION=<the region of that resource, e.g. eastus / westeurope>
